# Copy this file to .env (it is gitignored) and fill in only what you use.
# app.py reads .env from this folder only; variables already set in your shell win.

# Groq (free tier: https://console.groq.com/keys) -> --provider groq
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier: https://aistudio.google.com/apikey) -> --provider gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Any OpenAI-compatible API -> --provider openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional price sheet values (USD per 1,000 tokens) to enable --max-cost; unset means cost is unavailable.
REPOGUARD_INPUT_COST_PER_1K=
REPOGUARD_OUTPUT_COST_PER_1K=
